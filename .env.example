# Copy to .env.local and fill in. EXPO_PUBLIC_* values are embedded in the app bundle —
# never put secrets here.

# Base URL of the muzzle-recognition model server (see README "Muzzle model API").
# Leave empty to run with the simulated demo detector.
EXPO_PUBLIC_MUZZLE_API_URL=

# Cosine similarity at or above which two muzzles are treated as the same animal.
EXPO_PUBLIC_MUZZLE_MATCH_THRESHOLD=0.85
